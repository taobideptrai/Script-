-- 3. INVENTORY & TOOL MANAGEMENT SYSTEM
----------------------------------------------------
local InventoryManager = {
    Slots = 6,
    IsLocked = false,
    SearchQuery = ""
}

local function getEquippedTool()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Tool")
end

local function getToolsInBackpack()
    local tools = {}
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(tools, item)
            end
        end
    end
    return tools
end

local function getAllTools()
    local tools = getToolsInBackpack()
    local equipped = getEquippedTool()
    if equipped then
        table.insert(tools, 1, equipped)
    end
    return tools
end

local function equipToolByName(toolName: string)
    if InventoryManager.IsLocked then return end
    
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local currentTool = getEquippedTool()
    if currentTool and currentTool.Name == toolName then
        humanoid:UnequipTools()
        return
    end

    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        local targetTool = backpack:FindFirstChild(toolName)
        if targetTool then
            humanoid:EquipTool(targetTool)
        end
    end
end

