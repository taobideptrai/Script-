hotbarPage:addDivider("Quick Equip Slots")

for i = 1, 9 do
    hotbarPage:addButton("Slot " .. i .. " [Equip Tool #" .. i .. "]", function()
        local tools = getAllTools()
        if tools[i] then
            equipToolByName(tools[i].Name)
        end
    end)
end

-- Keybind handling (1-9 hotbar selection)
local EnumKeys = {
    Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three,
    Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six,
    Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine
}

for idx, key in ipairs(EnumKeys) do
    ContextActionService:BindAction("EquipSlot_" .. idx, function(_, state)
        if state == Enum.UserInputState.Begin then
            local tools = getAllTools()
            if tools[idx] then
                equipToolByName(tools[idx].Name)
            end
        end
    end, false, key)
end

-- Auto Refresh list when Backpack updates
local function bindBackpackEvents()
    local backpack = player:WaitForChild("Backpack")
    backpack.ChildAdded:Connect(function()
        task.wait(0.1)
        refreshToolList()
    end)
    backpack.ChildRemoved:Connect(function()
        task.wait(0.1)
        refreshToolList()
    end)
end

task.spawn(bindBackpackEvents)
player.CharacterAdded:Connect(function()
    task.wait(0.5)
    bindBackpackEvents()
    refreshToolList()
end)

-- Initial Refresh
refreshToolList()
