    if humanoid then humanoid:UnequipTools() end
end)

invPage:addDivider("Inventory Search & Equip")

local searchBox, _ = invPage:addTextBox("Search Filter", function(val)
    InventoryManager.SearchQuery = val:lower()
end)

local toolDropdown, _ = invPage:addDropdown("Equip Tool", {"None"}, function(selectedTool)
    if selectedTool and selectedTool ~= "None" and selectedTool ~= "" then
        equipToolByName(selectedTool)
    end
end)

local function refreshToolList()
    local tools = getAllTools()
    local toolNames = {}
    
    for _, tool in ipairs(tools) do
        if InventoryManager.SearchQuery == "" or string.find(tool.Name:lower(), InventoryManager.SearchQuery) then
            table.insert(toolNames, tool.Name)
        end
    end
    
    if #toolNames == 0 then
        toolNames = {"None"}
    end
    
    toolDropdown.Items = toolNames
end

invPage:addButton("Refresh Inventory List", function()
    refreshToolList()
end)

-- Page 2: Quick Hotbar Shortcuts
